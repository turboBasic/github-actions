{
  "gitignore": true,
  // disable VS Code extension from flagging this file in Problems
  "ignores": ["tmp/ad-hoc-prompts.md"],
  // MD013 (line length): prose here is never rewrapped, so `line_length` is effectively off.
  // `heading_line_length` stays enforced at 100 (matching .editorconfig's [*.py] and ruff) —
  // an oversized heading is a real smell, unlike an unwrapped paragraph.
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100000,
      "heading_line_length": 80
    }
  },
  // These files are intentionally headless
  "overrides": [
    {
      "filter": [
        ".github/PULL_REQUEST_TEMPLATE.md",
        "CLAUDE.md",
        ".github/copilot-instructions.md"
      ],
      "config": {
        "MD041": false
      },
      "combine": "merge"
    }
  ]
}
